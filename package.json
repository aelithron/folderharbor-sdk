{
  "name": "@folderharbor/sdk",
  "version": "1.1.2",
  "description": "Fully-featured TypeScript SDK for FolderHarbor",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/folderharbor/ts-sdk"
  },
  "homepage": "https://folderharbor.github.io/ts-sdk",
  "bugs": {
    "url": "https://github.com/folderharbor/ts-sdk/issues"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "docs": "typedoc --options typedoc.json"
  },
  "keywords": [
    "sdk",
    "folderharbor",
    "ts",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "author": "Nova",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "jiti": "^2.7.0",
    "msw": "^2.14.6",
    "ts-jest": "^29.4.11",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.19",
    "typedoc-theme-fresh": "^0.2.3",
    "typescript-eslint": "^8.60.0"
  }
}
